{
  "$comment": "Single source of truth for the npm platform packages. Each entry is published as its own package, listed in package.json optionalDependencies, and built from the release archive for `target`. Linux uses static musl binaries so one package works on glibc and musl distributions.",
  "platforms": [
    {
      "package": "gws-rust-darwin-arm64",
      "os": "darwin",
      "cpu": ["arm64"],
      "target": "aarch64-apple-darwin",
      "binary": "gwsr"
    },
    {
      "package": "gws-rust-darwin-x64",
      "os": "darwin",
      "cpu": ["x64"],
      "target": "x86_64-apple-darwin",
      "binary": "gwsr"
    },
    {
      "package": "gws-rust-linux-arm64",
      "os": "linux",
      "cpu": ["arm64"],
      "target": "aarch64-unknown-linux-musl",
      "binary": "gwsr"
    },
    {
      "package": "gws-rust-linux-x64",
      "os": "linux",
      "cpu": ["x64"],
      "target": "x86_64-unknown-linux-musl",
      "binary": "gwsr"
    },
    {
      "package": "gws-rust-win32-x64",
      "os": "win32",
      "cpu": ["x64", "arm64"],
      "target": "x86_64-pc-windows-msvc",
      "binary": "gwsr.exe"
    }
  ]
}
